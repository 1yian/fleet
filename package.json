{
  "name": "fleet",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:files": "prettier --check --ignore-unknown",
    "lint": "node lint.js",
    "typecheck": "node typecheck.js",
    "knip": "knip --treat-config-hints-as-errors",
    "deps": "depcruise .",
    "migrations:check": "node packages/cardd/scripts/check-migrations.ts",
    "test:e2e": "npm run build && node e2e/run.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm run deps && npm run migrations:check",
    "build": "npm run -w @fleet/board build",
    "prepare": "node githooks.js install"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.42.1",
    "oxc-parser": "0.159.0",
    "oxlint": "1.94.0",
    "oxlint-plugin-eslint": "1.94.0",
    "prettier": "3.9.10",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "6.0.3"
  }
}
