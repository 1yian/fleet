{
  "categories": {
    "correctness": "off"
  },
  "plugins": ["typescript", "eslint"],
  "jsPlugins": [
    {
      "name": "eslint-js",
      "specifier": "oxlint-plugin-eslint"
    },
    {
      "name": "hooks-js",
      "specifier": "eslint-plugin-react-hooks"
    },
    {
      "name": "fleet",
      "specifier": "./lint-plugin.js"
    }
  ],
  "ignorePatterns": [
    "**/node_modules/",
    "**/dist/",
    "packages/board/src/vendor/",
    "packages/extension/vendor/"
  ],
  "options": {
    "respectEslintDisableDirectives": false,
    "reportUnusedDisableDirectives": "error"
  },
  "settings": {
    "fleet": {
      "projects": [".", "packages/board"],
      "forbiddenDirectives": "(?:oxlint|eslint)(?:-|\\s)|^\\s*(?:global|globals|exported)\\b"
    }
  },
  "rules": {
    "eslint-js/for-direction": [2],
    "eslint-js/no-async-promise-executor": [2],
    "eslint-js/no-case-declarations": [2],
    "eslint-js/no-compare-neg-zero": [2],
    "eslint-js/no-cond-assign": [2, "except-parens"],
    "eslint-js/no-constant-binary-expression": [
      2,
      {
        "checkRelationalComparisons": false
      }
    ],
    "eslint-js/no-constant-condition": [
      2,
      {
        "checkLoops": "allExceptWhileTrue"
      }
    ],
    "eslint-js/no-control-regex": [2],
    "eslint-js/no-debugger": [2],
    "eslint-js/no-delete-var": [2],
    "eslint-js/no-dupe-else-if": [2],
    "eslint-js/no-duplicate-case": [2],
    "eslint-js/no-empty": [
      2,
      {
        "allowEmptyCatch": false
      }
    ],
    "eslint-js/no-empty-character-class": [2],
    "eslint-js/no-empty-pattern": [
      2,
      {
        "allowObjectPatternsAsParameters": false
      }
    ],
    "eslint-js/no-empty-static-block": [2],
    "eslint-js/no-ex-assign": [2],
    "eslint-js/no-extra-boolean-cast": [2, {}],
    "eslint-js/no-fallthrough": [
      2,
      {
        "allowEmptyCase": false,
        "reportUnusedFallthroughComment": false
      }
    ],
    "eslint-js/no-global-assign": [
      2,
      {
        "exceptions": []
      }
    ],
    "eslint-js/no-invalid-regexp": [2, {}],
    "eslint-js/no-irregular-whitespace": [
      2,
      {
        "skipComments": false,
        "skipJSXText": false,
        "skipRegExps": false,
        "skipStrings": true,
        "skipTemplates": false
      }
    ],
    "eslint-js/no-loss-of-precision": [2],
    "eslint-js/no-misleading-character-class": [
      2,
      {
        "allowEscape": false
      }
    ],
    "eslint-js/no-nonoctal-decimal-escape": [2],
    "eslint-js/no-octal": [2],
    "eslint-js/no-prototype-builtins": [2],
    "eslint-js/no-regex-spaces": [2],
    "eslint-js/no-self-assign": [
      2,
      {
        "props": true
      }
    ],
    "eslint-js/no-shadow-restricted-names": [
      2,
      {
        "reportGlobalThis": true
      }
    ],
    "eslint-js/no-sparse-arrays": [2],
    "eslint-js/no-unassigned-vars": [2],
    "eslint-js/no-unexpected-multiline": [2],
    "eslint-js/no-unreachable": [2],
    "eslint-js/no-unsafe-finally": [2],
    "eslint-js/no-unsafe-optional-chaining": [
      2,
      {
        "disallowArithmeticOperators": false
      }
    ],
    "eslint-js/no-unused-labels": [2],
    "eslint-js/no-unused-private-class-members": [2],
    "eslint-js/no-useless-assignment": [2],
    "eslint-js/no-useless-backreference": [2],
    "eslint-js/no-useless-catch": [2],
    "eslint-js/no-useless-escape": [
      2,
      {
        "allowRegexCharacters": []
      }
    ],
    "eslint-js/preserve-caught-error": [
      2,
      {
        "requireCatchParameter": false,
        "errorClassNames": []
      }
    ],
    "eslint-js/require-yield": [2],
    "eslint-js/use-isnan": [
      2,
      {
        "enforceForIndexOf": false,
        "enforceForSwitchCase": true
      }
    ],
    "eslint-js/valid-typeof": [
      2,
      {
        "requireStringLiterals": false
      }
    ],
    "eslint-js/no-var": [2],
    "eslint-js/prefer-const": [
      2,
      {
        "destructuring": "any",
        "ignoreReadBeforeAssign": false
      }
    ],
    "eslint-js/prefer-rest-params": [2],
    "eslint-js/prefer-spread": [2],
    "typescript/await-thenable": [2],
    "typescript/ban-ts-comment": [
      2,
      {
        "ts-expect-error": true,
        "ts-ignore": true,
        "ts-nocheck": true
      }
    ],
    "eslint/no-array-constructor": [2],
    "typescript/no-array-delete": [2],
    "typescript/no-base-to-string": [2],
    "typescript/no-confusing-void-expression": [2],
    "typescript/no-deprecated": [2],
    "typescript/no-duplicate-enum-values": [2],
    "typescript/no-duplicate-type-constituents": [2],
    "typescript/no-dynamic-delete": [2],
    "typescript/no-empty-object-type": [2],
    "typescript/no-explicit-any": [2],
    "typescript/no-extra-non-null-assertion": [2],
    "typescript/no-extraneous-class": [2],
    "typescript/no-floating-promises": [
      2,
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": ["test", "describe", "it"]
          }
        ]
      }
    ],
    "typescript/no-for-in-array": [2],
    "typescript/no-generated-empty-object-type": [2],
    "typescript/no-implied-eval": [2],
    "typescript/no-invalid-void-type": [2],
    "typescript/no-meaningless-void-operator": [2],
    "typescript/no-misused-new": [2],
    "typescript/no-misused-promises": [2],
    "typescript/no-misused-spread": [2],
    "typescript/no-mixed-enums": [2],
    "typescript/no-namespace": [2],
    "typescript/no-non-null-asserted-nullish-coalescing": [2],
    "typescript/no-non-null-asserted-optional-chain": [2],
    "typescript/no-non-null-assertion": [2],
    "typescript/no-redundant-type-constituents": [2],
    "typescript/no-require-imports": [2],
    "typescript/no-this-alias": [2],
    "typescript/no-unnecessary-boolean-literal-compare": [2],
    "typescript/no-unnecessary-condition": [2],
    "typescript/no-unnecessary-template-expression": [2],
    "typescript/no-unnecessary-type-arguments": [2],
    "typescript/no-unnecessary-type-assertion": [2],
    "typescript/no-unnecessary-type-constraint": [2],
    "typescript/no-unnecessary-type-conversion": [2],
    "typescript/no-unnecessary-type-parameters": [2],
    "typescript/no-unsafe-argument": [2],
    "typescript/no-unsafe-assignment": [2],
    "typescript/no-unsafe-call": [2],
    "typescript/no-unsafe-declaration-merging": [2],
    "typescript/no-unsafe-enum-assignment": [2],
    "typescript/no-unsafe-enum-comparison": [2],
    "typescript/no-unsafe-function-type": [2],
    "typescript/no-unsafe-member-access": [2],
    "typescript/no-unsafe-return": [2],
    "typescript/no-unsafe-unary-minus": [2],
    "eslint/no-unused-expressions": [
      2,
      {
        "allowShortCircuit": false,
        "allowTaggedTemplates": false,
        "allowTernary": false
      }
    ],
    "eslint/no-unused-vars": [
      2,
      {
        "vars": "all",
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "caughtErrors": "all",
        "ignoreRestSiblings": false,
        "ignoreClassWithStaticInitBlock": false,
        "ignoreUsingDeclarations": false,
        "reportUsedIgnorePattern": false,
        "reportVarsOnlyUsedAsTypes": true
      }
    ],
    "eslint/no-useless-constructor": [2],
    "typescript/no-useless-default-assignment": [2],
    "typescript/no-wrapper-object-types": [2],
    "typescript/only-throw-error": [2],
    "typescript/prefer-as-const": [2],
    "typescript/prefer-literal-enum-member": [2],
    "typescript/prefer-namespace-keyword": [2],
    "typescript/prefer-promise-reject-errors": [2],
    "typescript/prefer-reduce-type-parameter": [2],
    "typescript/prefer-return-this-type": [2],
    "typescript/related-getter-setter-pairs": [2],
    "typescript/require-await": [2],
    "typescript/restrict-plus-operands": [
      2,
      {
        "allowAny": false,
        "allowBoolean": false,
        "allowNullish": false,
        "allowNumberAndString": false,
        "allowRegExp": false
      }
    ],
    "typescript/restrict-template-expressions": [
      2,
      {
        "allowAny": false,
        "allowBoolean": false,
        "allowNever": false,
        "allowNullish": false,
        "allowNumber": false,
        "allowRegExp": false
      }
    ],
    "typescript/return-await": [2, "error-handling-correctness-only"],
    "typescript/triple-slash-reference": [2],
    "typescript/unbound-method": [2],
    "typescript/unified-signatures": [2],
    "typescript/use-unknown-in-catch-callback-variable": [2],
    "typescript/adjacent-overload-signatures": [2],
    "typescript/array-type": [2],
    "typescript/ban-tslint-comment": [2],
    "typescript/class-literal-property-style": [2],
    "typescript/consistent-generic-constructors": [2],
    "typescript/consistent-indexed-object-style": [2],
    "typescript/consistent-type-assertions": [
      2,
      {
        "assertionStyle": "never"
      }
    ],
    "typescript/consistent-type-definitions": [2],
    "typescript/dot-notation": [
      2,
      {
        "allowIndexSignaturePropertyAccess": false,
        "allowKeywords": true,
        "allowPattern": "",
        "allowPrivateClassPropertyAccess": false,
        "allowProtectedClassPropertyAccess": false
      }
    ],
    "typescript/no-confusing-non-null-assertion": [2],
    "eslint/no-empty-function": [
      2,
      {
        "allow": []
      }
    ],
    "typescript/no-inferrable-types": [2],
    "typescript/non-nullable-type-assertion-style": [2],
    "typescript/prefer-find": [2],
    "typescript/prefer-for-of": [2],
    "typescript/prefer-function-type": [2],
    "typescript/prefer-includes": [2],
    "typescript/prefer-nullish-coalescing": [2],
    "typescript/prefer-optional-chain": [2],
    "typescript/prefer-regexp-exec": [2],
    "typescript/prefer-string-starts-ends-with": [2],
    "fleet/no-comments": [2],
    "typescript/switch-exhaustiveness-check": [
      2,
      {
        "considerDefaultExhaustiveForUnions": false,
        "requireDefaultForNonUnion": true
      }
    ],
    "typescript/consistent-type-imports": [2],
    "eslint-js/complexity": [2, 10],
    "eslint-js/max-lines": [
      2,
      {
        "max": 500,
        "skipBlankLines": false,
        "skipComments": false
      }
    ],
    "eslint-js/max-lines-per-function": [
      2,
      {
        "max": 100,
        "skipBlankLines": false,
        "skipComments": false
      }
    ],
    "eslint-js/max-depth": [2, 3],
    "eslint-js/max-nested-callbacks": [2, 3],
    "eslint-js/eqeqeq": [2, "always"]
  },
  "overrides": [
    {
      "files": ["packages/board/**/*.tsx"],
      "rules": {
        "hooks-js/rules-of-hooks": [2],
        "hooks-js/exhaustive-deps": [1],
        "hooks-js/static-components": [2],
        "hooks-js/use-memo": [2],
        "hooks-js/void-use-memo": [2],
        "hooks-js/preserve-manual-memoization": [2],
        "hooks-js/incompatible-library": [1],
        "hooks-js/immutability": [2],
        "hooks-js/globals": [2],
        "hooks-js/refs": [2],
        "hooks-js/set-state-in-effect": [2],
        "hooks-js/error-boundaries": [2],
        "hooks-js/purity": [2],
        "hooks-js/set-state-in-render": [2],
        "hooks-js/unsupported-syntax": [1],
        "hooks-js/config": [2],
        "hooks-js/gating": [2]
      }
    },
    {
      "files": ["**/*.js", "**/*.cjs"],
      "rules": {
        "eslint-js/no-var": "off",
        "eslint-js/prefer-const": "off",
        "eslint-js/prefer-rest-params": "off",
        "eslint-js/prefer-spread": "off",
        "typescript/await-thenable": "off",
        "typescript/no-array-delete": "off",
        "typescript/no-base-to-string": "off",
        "typescript/no-confusing-void-expression": "off",
        "typescript/no-deprecated": "off",
        "typescript/no-duplicate-type-constituents": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-for-in-array": "off",
        "typescript/no-generated-empty-object-type": "off",
        "typescript/no-implied-eval": "off",
        "typescript/no-meaningless-void-operator": "off",
        "typescript/no-misused-promises": "off",
        "typescript/no-misused-spread": "off",
        "typescript/no-mixed-enums": "off",
        "typescript/no-redundant-type-constituents": "off",
        "typescript/no-unnecessary-boolean-literal-compare": "off",
        "typescript/no-unnecessary-condition": "off",
        "typescript/no-unnecessary-template-expression": "off",
        "typescript/no-unnecessary-type-arguments": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unnecessary-type-conversion": "off",
        "typescript/no-unnecessary-type-parameters": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-enum-assignment": "off",
        "typescript/no-unsafe-enum-comparison": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-unary-minus": "off",
        "typescript/no-useless-default-assignment": "off",
        "typescript/only-throw-error": "off",
        "typescript/prefer-promise-reject-errors": "off",
        "typescript/prefer-reduce-type-parameter": "off",
        "typescript/prefer-return-this-type": "off",
        "typescript/related-getter-setter-pairs": "off",
        "typescript/require-await": "off",
        "typescript/restrict-plus-operands": "off",
        "typescript/restrict-template-expressions": "off",
        "typescript/return-await": "off",
        "typescript/unbound-method": "off",
        "typescript/use-unknown-in-catch-callback-variable": "off",
        "typescript/dot-notation": "off",
        "typescript/non-nullable-type-assertion-style": "off",
        "typescript/prefer-find": "off",
        "typescript/prefer-includes": "off",
        "typescript/prefer-nullish-coalescing": "off",
        "typescript/prefer-optional-chain": "off",
        "typescript/prefer-regexp-exec": "off",
        "typescript/prefer-string-starts-ends-with": "off",
        "typescript/switch-exhaustiveness-check": "off",
        "eslint-js/constructor-super": [2],
        "eslint-js/getter-return": [
          2,
          {
            "allowImplicit": false
          }
        ],
        "eslint-js/no-class-assign": [2],
        "eslint-js/no-const-assign": [2],
        "eslint-js/no-dupe-args": [2],
        "eslint-js/no-dupe-class-members": [2],
        "eslint-js/no-dupe-keys": [2],
        "eslint-js/no-func-assign": [2],
        "eslint-js/no-import-assign": [2],
        "eslint-js/no-new-native-nonconstructor": [2],
        "eslint-js/no-obj-calls": [2],
        "eslint-js/no-redeclare": [
          2,
          {
            "builtinGlobals": true
          }
        ],
        "eslint-js/no-setter-return": [2],
        "eslint-js/no-this-before-super": [2],
        "eslint-js/no-undef": [
          2,
          {
            "typeof": false
          }
        ],
        "eslint-js/no-unsafe-negation": [
          2,
          {
            "enforceForOrderingRelations": false
          }
        ],
        "eslint-js/no-with": [2]
      }
    },
    {
      "files": ["**/*.cjs"],
      "globals": {
        "module": "writable"
      }
    },
    {
      "files": ["e2e/**/*.ts"],
      "rules": {
        "eslint-js/no-restricted-syntax": [
          2,
          {
            "selector": "Literal[value=/\\b(pkill|killall)\\b/]",
            "message": "Never kill a process by name in e2e code: one host runs the live herdr server, the lanes, and other workers' tests, and a name match kills them all. Stop only the lab session this test started, by its own --session name, or your own process by pid."
          },
          {
            "selector": "TemplateElement[value.raw=/\\b(pkill|killall)\\b/]",
            "message": "Never kill a process by name in e2e code: one host runs the live herdr server, the lanes, and other workers' tests, and a name match kills them all. Stop only the lab session this test started, by its own --session name, or your own process by pid."
          }
        ]
      }
    },
    {
      "files": ["e2e/extension/kill-guard.test.ts", "e2e/extension/no-browser.test.ts"],
      "rules": {
        "eslint-js/no-restricted-syntax": "off"
      }
    }
  ]
}
