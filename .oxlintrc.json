{
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "restriction": "error"
  },
  "plugins": [
    "typescript",
    "eslint",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "react",
    "react-perf",
    "jsx-a11y"
  ],
  "jsPlugins": [
    {
      "name": "hooks-js",
      "specifier": "eslint-plugin-react-hooks"
    },
    {
      "name": "fleet",
      "specifier": "./lint-plugin.js"
    }
  ],
  "ignorePatterns": [
    "**/node_modules/",
    "**/dist/",
    "packages/board/src/vendor/",
    "packages/extension/vendor/"
  ],
  "options": {
    "respectEslintDisableDirectives": false,
    "reportUnusedDisableDirectives": "error"
  },
  "settings": {
    "fleet": {
      "projects": [".", "packages/board"],
      "forbiddenDirectives": "(?:oxlint|eslint)(?:-|\\s)|^\\s*(?:global|globals|exported)\\b"
    }
  },
  "rules": {
    "eslint/for-direction": [2],
    "eslint/no-async-promise-executor": [2],
    "eslint/no-case-declarations": [2],
    "eslint/no-compare-neg-zero": [2],
    "eslint/no-cond-assign": [2, "except-parens"],
    "eslint/no-constant-binary-expression": [
      2,
      {
        "checkRelationalComparisons": false
      }
    ],
    "eslint/no-constant-condition": [
      2,
      {
        "checkLoops": "allExceptWhileTrue"
      }
    ],
    "eslint/no-control-regex": [2],
    "eslint/no-debugger": [2],
    "eslint/no-delete-var": [2],
    "eslint/no-dupe-else-if": [2],
    "eslint/no-duplicate-case": [2],
    "eslint/no-empty": [
      2,
      {
        "allowEmptyCatch": false
      }
    ],
    "eslint/no-empty-character-class": [2],
    "eslint/no-empty-pattern": [
      2,
      {
        "allowObjectPatternsAsParameters": false
      }
    ],
    "eslint/no-empty-static-block": [2],
    "eslint/no-ex-assign": [2],
    "eslint/no-extra-boolean-cast": [2, {}],
    "eslint/no-fallthrough": [
      2,
      {
        "allowEmptyCase": false,
        "reportUnusedFallthroughComment": false
      }
    ],
    "eslint/no-global-assign": [
      2,
      {
        "exceptions": []
      }
    ],
    "eslint/no-invalid-regexp": [2, {}],
    "eslint/no-irregular-whitespace": [
      2,
      {
        "skipComments": false,
        "skipJSXText": false,
        "skipRegExps": false,
        "skipStrings": true,
        "skipTemplates": false
      }
    ],
    "eslint/no-loss-of-precision": [2],
    "eslint/no-misleading-character-class": [
      2,
      {
        "allowEscape": false
      }
    ],
    "eslint/no-nonoctal-decimal-escape": [2],
    "eslint/no-prototype-builtins": [2],
    "eslint/no-regex-spaces": [2],
    "eslint/no-self-assign": [
      2,
      {
        "props": true
      }
    ],
    "eslint/no-shadow-restricted-names": [
      2,
      {
        "reportGlobalThis": true
      }
    ],
    "eslint/no-sparse-arrays": [2],
    "eslint/no-unassigned-vars": [2],
    "eslint/no-unexpected-multiline": [2],
