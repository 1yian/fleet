{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"]
    },
    "packages/cardd": {
      "entry": ["src/main.ts", "scripts/*.ts"]
    },
    "e2e": {
      "entry": ["**/*.test.ts", "support/fake-model.ts", "support/probe.ts"]
    },
    "packages/extension": {
      "entry": ["src/index.ts"]
    }
  },
  "ignoreBinaries": ["herdr"]
}
