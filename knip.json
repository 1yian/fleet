{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [".pi/extensions/*.ts"]
    },
    "packages/cardd": {
      "entry": ["src/main.ts", "scripts/*.ts"]
    },
    "e2e": {
      "entry": [
        "**/*.test.ts",
        "support/fake-model.ts",
        "support/fake-anthropic.ts",
        "support/probe.ts",
        "support/orphan-runner.ts",
        "support/leak-fixture.ts",
        "support/reaper.ts",
        "trial/*.ts"
      ]
    },
    "packages/extension": {
      "entry": [
        "src/index.ts",
        "src/job.ts",
        "src/launch.ts",
        "src/relaunch.ts",
        "src/calm/index.ts",
        "src/transcript/index.ts",
        "src/optchat.ts"
      ]
    },
    "packages/board": {
      "ignore": ["src/vendor/**"]
    }
  },
  "ignoreBinaries": ["herdr", "lavish-axi", "pgrep"]
}
